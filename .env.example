# Hugging Face — https://huggingface.co/settings/tokens
# Create a fine-grained token with "Inference Providers" permission.
VITE_HF_TOKEN=

# false = real AI when token is set | true = random placeholder photos
VITE_USE_MOCK=false

# Model on Inference Providers (warm text-to-image models)
VITE_HF_MODEL=black-forest-labs/FLUX.1-schnell
